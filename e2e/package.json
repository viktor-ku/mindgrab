{
  "name": "@mindgrab/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun --bun test ./editor.browser.ts ./project-repository.browser.ts ./accounts.browser.ts ./query.browser.ts",
    "test:offline": "bun --bun test ./offline-shell.browser.ts",
    "lint": "bun --bun run biome lint .",
    "format": "bun --bun run biome format --write .",
    "format:check": "bun --bun run biome format .",
    "lint:ts": "bun --bun run tsc -p tsconfig.json",
    "check": "bun --bun run lint && bun --bun run format:check && bun --bun run lint:ts"
  },
  "devDependencies": {
    "@tanstack/solid-query": "5.104.1",
    "@types/bun": "=1.4.2",
    "playwright": "1.62.0",
    "solid-js": "=1.9.15",
    "vite": "=8.3.0"
  }
}
