#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -d '' -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR -z)
if ((${#staged_files[@]} == 0)); then
  exit 0
fi

# Formatting must not stage unrelated working-tree changes.
for path in "${staged_files[@]}"; do
  if ! git diff --quiet -- "$path"; then
    printf 'Pre-commit: %q has unstaged changes. Stage or discard them before committing.\n' "$path" >&2
    exit 1
  fi
done

webapp_files=()
backend_files=()
e2e_files=()
for path in "${staged_files[@]}"; do
  [[ -f "$path" ]] || continue
  case "$path" in
    webapp/*)
      case "${path##*.}" in
        css|graphql|html|js|json|jsonc|md|mdx|ts|tsx) webapp_files+=("${path#webapp/}") ;;
      esac
      ;;
    e2e/*)
      case "${path##*.}" in
        css|graphql|html|js|json|jsonc|md|mdx|ts|tsx) e2e_files+=("${path#e2e/}") ;;
      esac
      ;;
    backend/*|shared/*)
      case "${path##*.}" in
        js|json|jsonc|ts|tsx) backend_files+=("../$path") ;;
      esac
      ;;
  esac
done

if ((${#webapp_files[@]} > 0)); then
  mise -C webapp exec -- bun --bun node_modules/.bin/biome format --write -- "${webapp_files[@]}"
  git add -- "${webapp_files[@]/#/webapp/}"
fi
if ((${#e2e_files[@]} > 0)); then
  mise -C e2e exec -- bun --bun node_modules/.bin/biome format --write -- "${e2e_files[@]}"
  git add -- "${e2e_files[@]/#/e2e/}"
fi
if ((${#backend_files[@]} > 0)); then
  mise -C backend exec -- bun --bun node_modules/.bin/biome format --write -- "${backend_files[@]}"
  git add -- "${backend_files[@]/#..\//}"
fi
mise run backend:check
mise run webapp:check
mise run e2e:check
