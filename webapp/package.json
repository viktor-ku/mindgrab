{
  "name": "mindgrab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "bun test --conditions browser",
    "test:browser": "bun --bun run --cwd ../e2e test",
    "build": "bun --bun run tsc -b && vite build",
    "preview": "vite preview",
    "lint": "bun --bun run biome lint .",
    "format": "bun --bun run biome format --write .",
    "format:check": "bun --bun run biome format .",
    "lint:ts": "bun --bun run tsc -b",
    "check": "bun --bun run lint && bun --bun run format:check && bun --bun run lint:ts",
    "test:offline": "bun --bun run --cwd ../e2e test:offline"
  },
  "dependencies": {
    "@solid-primitives/keyboard": "1.3.1",
    "@tanstack/solid-query": "5.104.1",
    "@tanstack/solid-router": "=1.170.36",
    "solid-js": "=1.9.15",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "=4.3.3",
    "@types/bun": "=1.4.2",
    "@types/node": "25.5.0",
    "tailwindcss": "=4.3.3",
    "vite": "=8.3.0",
    "vite-plugin-solid": "=2.11.14"
  }
}
