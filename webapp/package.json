{
  "name": "mindgrab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "bun test --conditions browser",
    "test:browser": "bun test ./tests/browser/editor.browser.ts ./tests/browser/project-repository.browser.ts ./tests/browser/accounts.browser.ts ./tests/browser/query.browser.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:ts": "tsc -b && tsc -p tsconfig.interop.json",
    "check": "bun --bun run lint && bun --bun run format:check && bun --bun run lint:ts",
    "test:offline": "bun test ./tests/browser/offline-shell.browser.ts"
  },
  "dependencies": {
    "@solid-primitives/keyboard": "1.3.1",
    "@tanstack/solid-query": "5.104.1",
    "@tanstack/solid-router": "=1.170.36",
    "fractional-indexing": "4.0.0",
    "lib0": "0.2.119",
    "solid-js": "=1.9.15",
    "y-indexeddb": "9.0.12",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33",
    "zod": "^4",
    "@mindgrab/document": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "=4.3.3",
    "@types/bun": "=1.4.2",
    "@types/node": "25.5.0",
    "playwright": "1.62.0",
    "tailwindcss": "=4.3.3",
    "typescript": "=7.0.2",
    "vite": "=8.3.0",
    "vite-plugin-solid": "=2.11.14"
  }
}
