{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip
	root * /srv

	# Hashed build output. Without the SPA fallback, a missing chunk is a real 404
	# and never index.html served under an immutable cache header.
	handle /assets/* {
		@present {
			not path */
			file
		}
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The API passes as PHP behind Apache (backend/README.md), and this site plays
	# along. Debian's Apache refuses `.ht*` at any depth, and this page is the only
	# place its version shows, because Cloudflare replaces `Server`. The wording is
	# copied from the php:8.3.14-apache image. It echoes nothing from the request.
	@htfiles path_regexp /\.ht
	handle @htfiles {
		header Content-Type "text/html; charset=iso-8859-1"
		respond <<PAGE
			<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
			<html><head>
			<title>403 Forbidden</title>
			</head><body>
			<h1>Forbidden</h1>
			<p>You don't have permission to access this resource.</p>
			<hr>
			<address>Apache/2.4.62 (Debian) Server at mindgrab.app Port 80</address>
			</body></html>

			PAGE 403
	}

	# The phpMyAdmin decoy is on the API's origin, away from this one's storage.
	@phpmyadmin path /phpmyadmin /phpmyadmin/*
	handle @phpmyadmin {
		redir https://api.mindgrab.app/phpmyadmin/ 301
	}

	# index.html (and the sw.js tombstone) must revalidate so a new build reaches browsers.
	handle {
		header Cache-Control "no-cache"

		@file {
			not path */ /index.html
			file
		}
		handle @file {
			file_server
		}

		# Every other path is the app shell, as if an index.php front controller
		# rendered it: PHP's header, and none of a static file's.
		handle {
			rewrite * /index.html
			header X-Powered-By "PHP/8.3.14"
			header -Last-Modified
			header -ETag
			header -Accept-Ranges
			file_server
		}
	}
}
