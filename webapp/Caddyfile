{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip
	root * /srv

	# Hashed build output. Without the SPA fallback, a missing chunk is a real 404
	# and never index.html served under an immutable cache header.
	handle /assets/* {
		@present {
			not path */
			file
		}
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html (and the sw.js tombstone) must revalidate so a new build reaches browsers.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
