# `mise run backend:dev` uses local login by default; no WorkOS credentials needed.
# Direct `cargo run`: set MINDGRAB_ENV=development and MINDGRAB_AUTH_MODE=local.
# Release builds require WorkOS. To test AuthKit locally, run
# MINDGRAB_AUTH_MODE=workos mise run backend:dev and configure these credentials.
WORKOS_CLIENT_ID=client_your_application
WORKOS_API_KEY=sk_your_secret_key
WORKOS_REDIRECT_URI=http://localhost:5173/api/auth/callback
DATABASE_URL=postgres://postgres@localhost:5432/mindgrab
# Defaults to the origin of WORKOS_REDIRECT_URI, with a trailing slash.
APP_URL=http://localhost:5173/
# Optional: override the default https://api.workos.com/user_management/<WORKOS_CLIENT_ID>.
# Set this to the exact issuer URL when using a custom token issuer.
# WORKOS_ISSUER=https://your-custom-issuer.example
# Optional product analytics (PostHog). Leave unset to send nothing (local dev, tests).
# Enable cookieless tracking in the PostHog project settings; declined visitors use it.
# VITE_POSTHOG_KEY=phc_your_project_api_key
# The backend proxies /ingest to PostHog and sends sign-ups; use the same key.
# POSTHOG_KEY=phc_your_project_api_key
# POSTHOG_HOST=https://eu.i.posthog.com
